<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>AirSpeaker @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="com.mylifer.airspeaker"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.mylifer.airspeaker" visible="false">
        <pkg-ref id="com.mylifer.airspeaker"/>
    </choice>
    <pkg-ref id="com.mylifer.airspeaker" version="@VERSION@" onConclusion="none">AirSpeaker-component.pkg</pkg-ref>
</installer-gui-script>
