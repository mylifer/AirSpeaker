{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AirSpeaker menü çubuğu uygulaması (LLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/.build/debug/AirSpeaker",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "AirSpeaker: Menü çubuğu uygulaması (debug derle)"
    },
    {
      "name": "airspeaker-check (LLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/airspeaker-check",
      "args": [
        "--list"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "AirSpeaker: Derle"
    }
  ]
}
