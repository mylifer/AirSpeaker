{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,

  // IntelliSense için clangd kullanılır (build/compile_commands.json).
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build",
    "--header-insertion=never"
  ],

  "files.encoding": "utf8",
  "files.associations": {
    "*.plist.in": "xml"
  },
  "files.exclude": {
    "build": true,
    "build-debug": true
  }
}
